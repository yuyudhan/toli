# Per-machine private state: never shared between the toli clones.
# Anchored to the repo root so tracked files such as src/core/config.ts stay visible.
/projects/
/data/
/state/
/config/
/logs/
# Private per-installation helpers (scripts, hooks, helpers.json): never committed.
/local/
# Claude Code per-user settings (.claude/settings.json is generated and tracked).
/.claude/settings.local.json

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
auth.json
*-password
*-pwd

# Bun / Node dependencies and build output
node_modules/
dist/
build/
out/
*.bun-build
coverage/
.cache/
*.tsbuildinfo

# Runtime and logs
*.log
*.db
*.db-wal
*.db-shm
tmp/

# Lavish review artifacts
.lavish/

# OS noise
.DS_Store
Thumbs.db

# Editor noise (vim, emacs, JetBrains, VS Code)
*.swp
*.swo
*~
\#*\#
.#*
*.~undo-tree~
.idea/
# VS Code: only the shared formatter setup is tracked.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
