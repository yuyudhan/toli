#!/usr/bin/env bash
# pre-commit: fast checks on what is being committed. Enable with `just hooks` (or `bun run hooks`).
#   1. Secrets scan of the staged changes (first: a leaked key cannot be undone by a later commit).
#   2. scripts/format.ts formats the staged files of every type it owns (Biome, Prettier, Taplo, shfmt,
#      just --fmt) and re-stages the ones it changed.
#      Partial staging caveat: formatting rewrites the whole working-tree file and `git add` re-stages
#      all of it, so unstaged hunks in a reformatted staged file get committed too. Stash them first
#      (`git stash push --keep-index`) if you need a partial commit.
#   3. Lint of the staged files (Biome rules, shellcheck, actionlint).
#   4. Type-check (tsc) of the staged tree, exported to a temp directory, when a staged file is TypeScript: other
#      agents' unfinished edits in the working tree neither break nor pass this commit.
#   5. Guards over the staged files only (TOLI_GUARD_HOOK=1).
# The test suite runs in pre-push (`just check`), not here; commits stay fast on purpose.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

for tool in gitleaks bun; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "pre-commit: $tool not found on PATH; install it before committing (bun: https://bun.sh; others: just setup lists the command for this OS)" >&2
        exit 1
    fi
done

echo "pre-commit: secrets scan (staged)"
gitleaks git --staged --config .gitleaks.toml --redact --no-banner --log-level warn

files=()
while IFS= read -r -d '' file; do
    [[ -f "$file" ]] && files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if ((${#files[@]} > 0)); then
    echo "pre-commit: formatting ${#files[@]} staged file(s)"
    before=()
    while IFS= read -r hash; do before+=("$hash"); done < <(git hash-object -- "${files[@]}")
    bun scripts/format.ts write -- "${files[@]}"
    after=()
    while IFS= read -r hash; do after+=("$hash"); done < <(git hash-object -- "${files[@]}")
    changed=()
    for i in "${!files[@]}"; do
        [[ "${before[i]}" == "${after[i]}" ]] || changed+=("${files[i]}")
    done
    if ((${#changed[@]} > 0)); then
        echo "pre-commit: re-staging ${#changed[@]} reformatted file(s)"
        git add -- "${changed[@]}"
    fi
fi

if ((${#files[@]} > 0)); then
    echo "pre-commit: lint (staged)"
    bun scripts/format.ts lint -- "${files[@]}"
    for file in "${files[@]}"; do
        if [[ "$file" == *.ts ]]; then
            echo "pre-commit: typecheck (staged tree)"
            staged="$(mktemp -d)"
            trap 'rm -rf "$staged"' EXIT
            git checkout-index --all --prefix="$staged/"
            ln -s "$root/node_modules" "$staged/node_modules"
            (cd "$staged" && "$root/node_modules/.bin/tsc" --noEmit --project tsconfig.json)
            break
        fi
    done
fi

echo "pre-commit: guards (staged)"
TOLI_GUARD_HOOK=1 bun scripts/guard.ts
