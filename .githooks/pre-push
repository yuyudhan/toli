#!/usr/bin/env bash
# pre-push: the full gate. A gitleaks scan of the commits being pushed, then `bun run check` (= `just check`:
# fmt-check, lint, typecheck, tests). A pushed commit that already passed (`bin/toli gate check`) is not checked
# again. When the checkout is exactly the pushed commit (HEAD, no changed or untracked files), the checks run as a
# `bin/toli gate`, so the result is recorded for that commit. Otherwise they run on the working tree as they always
# did, after listing how it differs: that result is not recorded, since it is not the commit's. No copy is made.
#
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>. Per ref:
#   - deletion (local sha all zeros): no commits to check
#   - new ref (remote sha all zeros): count/scan `<local sha> --not --remotes=<remote>`
#   - existing ref: count/scan exactly `<remote sha>..<local sha>`; never `--not --remotes`, which
#     excludes commits reachable from ANY remote ref and can skip a real push after a branch merge
# The gate is skipped only when at least one ref line was read, every count succeeded, and the total
# is zero (e.g. a tag on an already-pushed commit). Zero ref lines means the input is unknown, not
# empty, so the gate runs with a full-history secrets scan; so does any count that fails.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
remote="${1:-origin}"

for tool in gitleaks bun; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "pre-push: $tool not found on PATH; install it before pushing" >&2
        exit 1
    fi
done

zero="$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')"
refs=0
commits=0
unknown=0
scans=()
shas=()

while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${local_ref:-}" ]] || continue
    refs=$((refs + 1))
    [[ "$local_sha" != "$zero" ]] || continue
    if [[ "$remote_sha" == "$zero" ]]; then
        log_opts="$local_sha --not --remotes=$remote"
        count="$(git rev-list --count "$local_sha" --not --remotes="$remote")" || count=""
    else
        log_opts="$remote_sha..$local_sha"
        count="$(git rev-list --count "$remote_sha..$local_sha" 2>/dev/null)" || count=""
    fi
    if [[ -z "$count" ]]; then
        echo "pre-push: cannot count commits for $local_ref -> $remote_ref; treating as unknown"
        unknown=1
    elif ((count > 0)); then
        commits=$((commits + count))
        scans+=("$log_opts")
        [[ " ${shas[*]:-} " == *" $local_sha "* ]] || shas+=("$local_sha")
    fi
done

if ((refs > 0 && unknown == 0 && commits == 0)); then
    echo "pre-push: $refs ref(s), no new commits; skipping the gate"
    exit 0
fi

if ((refs == 0 || unknown == 1)); then
    echo "pre-push: pushed range unknown; secrets scan over full history"
    gitleaks git --config .gitleaks.toml --redact --no-banner --log-level warn
    shas=("$(git rev-parse HEAD)")
else
    echo "pre-push: secrets scan over $commits pushed commit(s)"
    for log_opts in "${scans[@]}"; do
        gitleaks git --config .gitleaks.toml --redact --no-banner --log-level warn --log-opts="$log_opts"
    done
fi

recipe="bun run check"
toli="$root/bin/toli"
tree_check=0
for sha in "${shas[@]}"; do
    short="${sha:0:12}"
    if "$toli" gate check toli --sha "$sha" --recipe "$recipe" >/dev/null 2>&1; then
        echo "pre-push: $recipe already passed on $short (bin/toli gate check); skipping it"
        continue
    fi
    head="$(git rev-parse HEAD)"
    changes="$(git status --porcelain)"
    if [[ "$sha" == "$head" && -z "$changes" ]]; then
        # The checkout is exactly the pushed commit, so its code is what runs (TOLI_DEV=1) and what is tested.
        echo "pre-push: $recipe on $short (bin/toli gate run)"
        TOLI_DEV=1 "$toli" gate run toli --recipe "$recipe"
        continue
    fi
    echo "pre-push: this checkout is not exactly the pushed commit $short, so its check is not recorded for it:"
    [[ "$sha" == "$head" ]] || echo "    HEAD is ${head:0:12}, not the pushed commit"
    [[ -z "$changes" ]] || printf '%s\n' "$changes" | sed -n '1,20s/^/    /p'
    tree_check=1
done

if ((tree_check == 1)); then
    # One run covers every such commit: it tests the working tree, whichever commit is pushed.
    echo "pre-push: $recipe on the working tree (just check)"
    bun run check
fi
