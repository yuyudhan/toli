#!/usr/bin/env bash
# commit-msg: subject non-empty, <= 72 characters, no trailing period; blank line before any body;
# no AI attribution (Co-authored-by naming an assistant, Generated-by trailers, "generated with" stamps).
# Comment lines and everything below a `git commit -v` scissors line are ignored, as git strips them.
set -euo pipefail

file="$1"
comment="$(git config --get core.commentChar || true)"
if [[ -z "$comment" || "$comment" == "auto" ]]; then comment="#"; fi

message="$(awk -v c="$comment" '
    index($0, c " ------------------------ >8 ------------------------") == 1 { exit }
    index($0, c) == 1 { next }
    { print }
' "$file")"

subject="$(printf '%s\n' "$message" | awk 'NF { print; exit }')"
second="$(printf '%s\n' "$message" | awk 'NF { if ((getline line) > 0) print line; exit }')"

fail() {
    echo "commit-msg: $1" >&2
    exit 1
}

[[ -n "$subject" ]] || fail "empty subject line"
((${#subject} <= 72)) || fail "subject is ${#subject} characters; keep it to 72 or fewer"
[[ "$subject" != *. ]] || fail "subject ends with a period"
[[ -z "${second//[[:space:]]/}" ]] || fail "leave a blank line between the subject and the body"

assistant='(claude|anthropic|chatgpt|openai|gpt-?[0-9][[:alnum:].]*|copilot|gemini|codex|cursor|omp|oh my pi|ai|llm)'
if printf '%s\n' "$message" | grep -Eiq "^[[:space:]]*co-authored-by:.*([^[:alnum:]]|^)${assistant}([^[:alnum:]]|$)"; then
    fail "AI co-author trailer; remove the Co-authored-by line"
fi
if printf '%s\n' "$message" | grep -Eiq '^[[:space:]]*generated-by:'; then
    fail "Generated-by trailer; remove it"
fi
if printf '%s\n' "$message" | grep -Eiq "generated (by|with)[^[:alnum:]].{0,40}([^[:alnum:]]|^)${assistant}([^[:alnum:]]|$)"; then
    fail "AI 'generated by' stamp; remove it"
fi
