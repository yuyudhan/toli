{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write|NotebookEdit|Read|Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-pre-tool",
                        "timeout": 30
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-prompt",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
