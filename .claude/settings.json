{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|MultiEdit|Write|NotebookEdit|Read|Grep|Glob",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-pre-tool",
                        "timeout": 30
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-agent",
                        "timeout": 30,
                        "async": true
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-agent",
                        "timeout": 30,
                        "async": true
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-agent",
                        "timeout": 30,
                        "async": true
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-prompt",
                        "timeout": 30
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/bin/toli hook claude-session-start",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
