root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# shfmt reads these when run without formatting flags (scripts/format.ts relies on that).
[{*.sh,*.bash,.githooks/*}]
switch_case_indent = true
binary_next_line = true
