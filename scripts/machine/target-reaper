#!/usr/bin/env python3
"""Keep enough free disk for builds by deleting idle cargo target directories.

Run every 15 minutes by launchd (com.yuyudhan.toli.target-reaper, installed by
scripts/machine/install-launchd; 2026-10-27/28: builds kept stopping because the
data volume ran out of space). When free space on
the data volume is below LOW_GB, it deletes cargo `target/` directories, least
recently built first, until free space reaches HIGH_GB. A target directory is
eligible only if:

- it is a cargo target (CACHEDIR.TAG or .rustc_info.json inside, or a Cargo.toml beside it),
- no build has used it for at least IDLE_HOURS (30 minutes by default, so only a
  build that is running or just finished keeps its folder), and
- no process currently holds any of its `.cargo-lock` files open.

Only build output is removed; sources, branches, worktrees and Docker data are
never touched. The cost of a deletion is a rebuild the next time that worktree
builds. Every deletion is logged.

`--now` ignores LOW_GB and frees down to HIGH_GB immediately; `--dry-run`
lists what would be deleted.
"""
from __future__ import annotations

import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

ROOTS = [
    Path.home() / ".treehouse",
    Path.home() / "code",
]
SKIP_DIRS = {".git", "node_modules", ".cache", "Library", ".Trash"}
MAX_DEPTH = 7
DATA_VOLUME = "/System/Volumes/Data"
LOW_GB = float(os.environ.get("TOLI_REAPER_LOW_GB", "150"))
HIGH_GB = float(os.environ.get("TOLI_REAPER_HIGH_GB", "250"))
IDLE_HOURS = float(os.environ.get("TOLI_REAPER_IDLE_HOURS", "0.5"))
LOG_FILE = Path.home() / "Library" / "Logs" / "toli-target-reaper.log"


def log(message: str) -> None:
    stamp = time.strftime("%Y-%m-%dT%H:%M:%S%z")
    LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a") as handle:
        handle.write(f"{stamp} {message}\n")


def free_gb() -> float:
    stats = os.statvfs(DATA_VOLUME)
    return stats.f_bavail * stats.f_frsize / 2**30


def is_cargo_target(path: Path) -> bool:
    """Cargo writes CACHEDIR.TAG and .rustc_info.json into target/; custom-profile-only targets may lack the tag."""
    return any((path / marker).is_file() for marker in ("CACHEDIR.TAG", ".rustc_info.json")) or (
        path.parent / "Cargo.toml"
    ).is_file()


def find_targets() -> list[Path]:
    found: list[Path] = []
    for root in ROOTS:
        if not root.is_dir():
            continue
        base_depth = len(root.parts)
        for current, dirs, _files in os.walk(root):
            here = Path(current)
            if len(here.parts) - base_depth >= MAX_DEPTH:
                dirs[:] = []
                continue
            keep = []
            for name in dirs:
                if name in SKIP_DIRS:
                    continue
                child = here / name
                if name == "target" and is_cargo_target(child):
                    found.append(child)
                    continue
                if child.is_symlink():
                    continue
                keep.append(name)
            dirs[:] = keep
    return found


def cargo_locks(target: Path) -> list[Path]:
    locks = [target / ".cargo-lock"]
    try:
        for entry in target.iterdir():
            if entry.is_dir():
                locks.append(entry / ".cargo-lock")
                for sub in entry.iterdir() if entry.name not in {"debug", "release"} else []:
                    if sub.is_dir():
                        locks.append(sub / ".cargo-lock")
    except OSError:
        pass
    return [lock for lock in locks if lock.is_file()]


def last_used(target: Path, locks: list[Path]) -> float:
    """Newest mtime among lock files and the per-profile build output directories.

    Cargo rewrites `deps`, `.fingerprint` and `incremental` entries whenever it
    compiles, so their directory mtimes track the last real build.
    """
    stamps = [target.stat().st_mtime]
    for lock in locks:
        profile = lock.parent
        stamps.append(lock.stat().st_mtime)
        for name in ("deps", ".fingerprint", "incremental", "build"):
            child = profile / name
            if child.is_dir():
                stamps.append(child.stat().st_mtime)
    return max(stamps)


def in_use(locks: list[Path]) -> bool:
    if not locks:
        return False
    result = subprocess.run(
        ["/usr/sbin/lsof", "-t", *map(str, locks)], capture_output=True, text=True, check=False
    )
    return bool(result.stdout.strip())


def main() -> int:
    dry_run = "--dry-run" in sys.argv
    force = "--now" in sys.argv
    start = free_gb()
    if start >= LOW_GB and not force:
        return 0
    cutoff = time.time() - IDLE_HOURS * 3600
    candidates: list[tuple[float, Path]] = []
    for target in find_targets():
        locks = cargo_locks(target)
        used = last_used(target, locks)
        if used > cutoff or in_use(locks):
            continue
        candidates.append((used, target))
    candidates.sort()
    freed_any = False
    for used, target in candidates:
        if free_gb() >= HIGH_GB:
            break
        age_h = (time.time() - used) / 3600
        if dry_run:
            sys.stdout.write(f"would delete {target} (idle {age_h:.0f} h)\n")
            continue
        before = free_gb()
        shutil.rmtree(target, ignore_errors=True)
        log(f"deleted {target} (idle {age_h:.0f} h), freed {free_gb() - before:.1f} GB")
        freed_any = True
    if freed_any:
        log(f"free space {start:.0f} GB -> {free_gb():.0f} GB")
    return 0


if __name__ == "__main__":
    sys.exit(main())
