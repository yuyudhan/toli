#!/usr/bin/env bash
# Install (or reinstall) this machine's toli maintenance helpers as launchd agents (macOS only).
#
#   scripts/machine/install-launchd cargo-sweep target-reaper [netbird-watch] [omp-auth-broker]
#
# cargo-sweep      hourly cargo-sweep of idle target/ output in projects/ and ~/.treehouse
# target-reaper    every 15 min; deletes idle cargo target/ dirs when the data volume runs low
# netbird-watch    every minute; reconnects NetBird (needs the fm-netbird-setup-key Keychain item)
# omp-auth-broker  keeps `omp auth-broker serve` running; needs TOLI_AUTH_BROKER_BIND=<tailnet-ip>:<port>
#
# Each agent is labelled com.yuyudhan.toli.<helper> and logs to ~/Library/Logs/toli-<helper>.log. A legacy
# com.firstmate.* agent for the same helper is unloaded and its plist removed. Re-running is safe.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
agents="${TOLI_LAUNCH_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
domain="gui/$(id -u)"
logs="$HOME/Library/Logs"
path_env="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [ "$(uname -s)" != Darwin ]; then
    echo "install-launchd: macOS only" >&2
    exit 1
fi
if [ "$#" -eq 0 ]; then
    sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2
    exit 2
fi

xml_escape() {
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# write_plist <label> <schedule-xml> <program> [args...]
write_plist() {
    local label="$1" schedule="$2" helper="${1#com.yuyudhan.toli.}" args="" arg
    shift 2
    for arg in "$@"; do
        args+="        <string>$(printf '%s' "$arg" | xml_escape)</string>"$'\n'
    done
    local file="$agents/$label.plist" tmp
    tmp="$(mktemp "$agents/.$label.XXXXXX")"
    cat >"$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$label</string>
    <key>ProgramArguments</key>
    <array>
$args    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$path_env</string>
    </dict>
$schedule
    <key>StandardOutPath</key>
    <string>$logs/toli-$helper.log</string>
    <key>StandardErrorPath</key>
    <string>$logs/toli-$helper.log</string>
</dict>
</plist>
EOF
    plutil -lint "$tmp" >/dev/null
    mv "$tmp" "$file"
}

retire_legacy() {
    local legacy="com.firstmate.$1"
    launchctl bootout "$domain/$legacy" 2>/dev/null || true
    rm -f "$agents/$legacy.plist"
}

load() {
    local label="$1"
    launchctl bootout "$domain/$label" 2>/dev/null || true
    launchctl enable "$domain/$label"
    launchctl bootstrap "$domain" "$agents/$label.plist"
    echo "loaded $label"
}

interval() {
    printf '    <key>StartInterval</key>\n    <integer>%s</integer>\n' "$1"
}

mkdir -p "$agents" "$logs"
for helper in "$@"; do
    label="com.yuyudhan.toli.$helper"
    case "$helper" in
    cargo-sweep)
        write_plist "$label" "$(interval 3600)
    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>" "$root/scripts/machine/cargo-sweep"
        retire_legacy cargo-sweep
        ;;
    target-reaper)
        write_plist "$label" "$(interval 900)
    <key>RunAtLoad</key>
    <true/>" /usr/bin/python3 "$root/scripts/machine/target-reaper"
        retire_legacy target-reaper
        ;;
    netbird-watch)
        write_plist "$label" "$(interval 60)
    <key>RunAtLoad</key>
    <true/>" "$root/scripts/machine/netbird-watch"
        retire_legacy netbird-watch
        ;;
    omp-auth-broker)
        bind="${TOLI_AUTH_BROKER_BIND:?set TOLI_AUTH_BROKER_BIND=<tailnet-ip>:<port>}"
        omp_bin="$(command -v omp || true)"
        [ -n "$omp_bin" ] || {
            echo "install-launchd: omp not on PATH" >&2
            exit 1
        }
        write_plist "$label" "    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>" "$omp_bin" auth-broker serve --bind "$bind"
        retire_legacy omp-auth-broker-tailnet
        ;;
    *)
        echo "install-launchd: unknown helper '$helper'" >&2
        exit 2
        ;;
    esac
    load "$label"
done
