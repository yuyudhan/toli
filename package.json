{
    "name": "toli",
    "version": "0.2.0",
    "private": true,
    "license": "MIT",
    "type": "module",
    "bin": {
        "toli": "bin/toli"
    },
    "scripts": {
        "format": "bun scripts/format.ts write",
        "format:check": "bun scripts/format.ts check",
        "lint": "bun scripts/format.ts lint && bun scripts/guard.ts && bun scripts/useless-await.ts",
        "typecheck": "tsc --noEmit",
        "tools": "bun scripts/format.ts tools",
        "test": "bun test --timeout 60000",
        "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
        "verify": "bun run check && bun scripts/verify.ts",
        "release": "bun scripts/publish.ts",
        "guard": "bun scripts/guard.ts",
        "hooks": "git config core.hooksPath .githooks"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@happy-dom/global-registrator": "21.0.4",
        "@taplo/cli": "0.7.0",
        "@types/bun": "1.3.14",
        "mermaid": "12.2.0",
        "prettier": "3.9.10",
        "typescript": "^5.9.3"
    }
}
